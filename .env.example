# ==============================================================================
# OmniSync — Production Environment Variables Template (Vercel + PostgreSQL)
# ==============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your Vercel Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Database Connection (Neon / Supabase / Hosted PostgreSQL or Local SQLite)
# ------------------------------------------------------------------------------
# Production (Neon / Supabase Pooled Connection String with PgBouncer):
# DATABASE_URL="postgresql://neondb_owner:password@ep-cool-forest-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5"
#
# Local Development (SQLite fallback):
DATABASE_URL="file:./dev.db"

# Optional Direct Database URL for Prisma CLI migrations (Neon / Supabase non-pooled port 5432):
# DIRECT_URL="postgresql://neondb_owner:password@ep-cool-forest-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Google Gemini AI (RTO Fraud & COD Risk Scoring Engine)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_google_ai_studio_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. Public Application Base URL
# ------------------------------------------------------------------------------
# Local: http://localhost:3000
# Production: https://your-omnisync-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Optional Session & Webhook HMAC Secrets
# ------------------------------------------------------------------------------
OMNISYNC_SESSION_SECRET="replace_with_32_byte_random_session_secret"
OMNISYNC_WEBHOOK_SECRET="replace_with_webhook_hmac_sha256_secret"
